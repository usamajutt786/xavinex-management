NODE_ENV=development
HOST=127.0.0.1
PORT=4000
# The local launcher uses the installed mongod on a dedicated port and data path.
# For your own MongoDB replica set/Atlas, replace this URI and set LOCAL_MONGO=false.
MONGODB_URI=mongodb://127.0.0.1:27018/xavinex_management?replicaSet=xavinex-local
LOCAL_MONGO=true
# Optional absolute path if mongod is not installed in its standard location/PATH.
MONGOD_PATH=
APP_ORIGIN=http://localhost:3000
# Set to 1 only behind one trusted reverse proxy.
TRUST_PROXY=0
SESSION_HOURS=12
# Used only by npm run bootstrap. No default user/password is shipped.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrator
ADMIN_PASSWORD=
